# Application
APP_NAME=ATS
APP_ENV=development
LOG_LEVEL=info

# API / frontend endpoints
API_HOST=0.0.0.0
API_PORT=8000
WEB_HOST=0.0.0.0
WEB_PORT=3000
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Caddy production deployment
PUBLIC_HOST=ats.34.21.188.225.nip.io
API_UPSTREAM=127.0.0.1:8000
WEB_ROOT=/home/weihao95/workspace/ATS/dist
LOG_FILE=/var/log/caddy/ats.log

# PostgreSQL / pgvector
DATABASE_URL=postgresql://ats:change-me@localhost:5432/ats
POSTGRES_DB=ats
POSTGRES_USER=ats
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Queue backend
VALKEY_URL=redis://localhost:6379/0
VALKEY_HOST=localhost
VALKEY_PORT=6379

# n8n
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=ats
N8N_BASIC_AUTH_PASSWORD=change-me
N8N_ENCRYPTION_KEY=replace-with-32-char-random-string
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
N8N_INBOUND_TOKEN=change-me
N8N_OUTBOUND_TOKEN=change-me

# Auth / sessions
JWT_SECRET=change-me
SESSION_SECRET=change-me

# Object storage baseline
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=ats
OBJECT_STORAGE_ACCESS_KEY=change-me
OBJECT_STORAGE_SECRET_KEY=change-me
